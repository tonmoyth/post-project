model Post {
  id          String   @id @default(cuid())
  title       String
  description String
  url         String?
  authorId    String
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  votes       Vote[]
  comments    Comment[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
